{
  "name": "@tailor-cms/config-parser",
  "description": "Access parsed Tailor config",
  "author": "Studion <tools@gostudion.com>",
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "scripts": {
    "dev": "tsdown --watch src",
    "build": "tsdown"
  },
  "dependencies": {
    "@tailor-cms/interfaces": "workspace:^",
    "lodash-es": "^4.18.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
